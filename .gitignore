# Frappe / ERPNext temporary
*.log
sites/*/private/
sites/*/public/files/

# Cookie jars created by translation scripts (curl -c /tmp/lt_cookies)
*_cookies

# Upstream frappe_docker clone plus LT compose file. Current runtime uses the
# custom locally-twisted-erpnext:v15 image and a live-edit bind mount for the
# LT app. The old nginx Origin patch script is historical/fallback only.
Locally-Twisted-Backend/

# Upstream Frappe apps are image-owned in the current custom-image stack.
# Keep host clones ignored if old setup scripts or exploratory work recreate them.
apps/webshop/
apps/payments/

# Empty placeholder; reserved for future frontend assets
Locally-Twisted-Frontend/

# Scratch / one-off scaffolding (image generator script, throwaway HTML pulls)
# The IMAGES go in _resources/images/ which IS committed.
.scratch/

# Raw client/photo drops are source material, not repo source. Curated/optimized
# production assets belong in committed app/_resources paths with explicit names.
assets/New Balloon Pics 3.7.26/

# Screenshot accumulation from Playwright recon runs — large (100+ MB across
# sessions), not source-of-truth. Smoke test (scripts/verify/smoke_shop.py)
# regenerates current state on demand.
scripts/verify/_screenshots/

# Browser profiles and throwaway visual verification captures from local QA.
# These are generated by Chrome/Edge/Playwright runs and are not source.
scripts/verify/_chrome-profile*/
scripts/verify/_edge-profile*/
_resources/webshop-redesign-verify/
output/
test invoices/

# Local Superpowers visual companion sessions.
.superpowers/

# Generated local audit/mirror payloads. Keep committed reports/inventories and
# capture scripts, but do not track bulky re-creatable HTML/assets/screenshots.
_resources/a11y-audit-2026-04-30/*.json
_resources/a11y-audit-2026-04-30/*.png
_resources/audit-2026-04-30-chrome/
_resources/odoo-live-mirror/assets/
_resources/odoo-live-mirror/pages/
_resources/odoo-live-mirror/manifest.json
_resources/webshop-spec-2026-04-30/
_resources/webshop-state-vs-spec-2026-04-30/screenshots/

# Bind-mount staging copy of the seed data — duplicate of _resources/odoo-live/
# kept here so it's accessible inside the locally_twisted container at the same
# path. Re-staged from _resources/odoo-live/ when the seed needs to run.
apps/locally_twisted/locally_twisted/seed/_data/

# Throwaway HTML fetched during scraper development. Re-fetchable; not source-of-truth.
_resources/_tmp_odoo_sample.html

# Local-only design/research packets kept for active critique or OpenClaw handoff.
# Do not track these as LT production source; keep production translation in app files.
research/a unique portfolio page for a high end corporate balloon events_.zip
research/a unique portfolio page for a high end corporate balloon events_/
research/design_handoff_locally_twisted_portfolio/
research/portfolio-design-cla/
research/balloon physics/
