# Secrets
.env
*.env.local
*.secret

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# Node (if Frontend folder grows)
node_modules/
dist/
build/

# Frappe / ERPNext temporary
*.log
sites/*/private/
sites/*/public/files/

# Cookie jars created by translation scripts (curl -c /tmp/lt_cookies)
*_cookies

# Upstream frappe_docker clone (reproducible from upstream + v15.105.0 pin in CLAUDE.md)
# Has its own .git/; nginx Origin patch lives in scripts/fix/patch_nginx_socketio_origin.py
Locally-Twisted-Backend/

# Upstream Frappe apps (installed via scripts/setup/install_webshop.py).
# Source-of-truth for HOW we install them lives in that script.
# We bind-mount these into the docker stack so each frappe-image service can import them.
apps/webshop/
apps/payments/

# Empty placeholder; reserved for future frontend assets
Locally-Twisted-Frontend/

# Scratch / one-off scaffolding (image generator script, throwaway HTML pulls)
# The IMAGES go in _resources/images/ which IS committed.
.scratch/

# Screenshot accumulation from Playwright recon runs — large (100+ MB across
# sessions), not source-of-truth. Smoke test (scripts/verify/smoke_shop.py)
# regenerates current state on demand.
scripts/verify/_screenshots/

# Browser profiles and throwaway visual verification captures from local QA.
# These are generated by Chrome/Edge/Playwright runs and are not source.
scripts/verify/_chrome-profile*/
scripts/verify/_edge-profile*/
_resources/webshop-redesign-verify/
output/

# Bind-mount staging copy of the seed data — duplicate of _resources/odoo-live/
# kept here so it's accessible inside the locally_twisted container at the same
# path. Re-staged from _resources/odoo-live/ when the seed needs to run.
apps/locally_twisted/locally_twisted/seed/_data/

# Throwaway HTML fetched during scraper development. Re-fetchable; not source-of-truth.
_resources/_tmp_odoo_sample.html
